<!--
  Shared build + package metadata for every project in this repository.
  Per-project settings (PackageId, Description, tags) live in the project file.
-->
<Project>

  <PropertyGroup>
    <!-- C# 7.3 was the SDK's default for net472, not a requirement of it: the modern
         compiler supports current language versions against net472 too, and only a
         handful of features need runtime support this library does not use. `latest`
         is deterministic here because global.json pins the SDK, so the language
         version cannot move without a deliberate SDK change. -->
    <LangVersion>latest</LangVersion>
    <Authors>Tony Goodhew</Authors>
    <Company>Tony Goodhew</Company>
    <Copyright>Copyright (c) 2026 Tony Goodhew</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TGoodhew/Hpgl.Rendering</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TGoodhew/Hpgl.Rendering</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Source Link: consumers can step into this library in the debugger, and the
       symbols published alongside the package resolve to the exact commit. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
